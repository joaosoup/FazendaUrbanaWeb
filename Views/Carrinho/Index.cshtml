@model TesteHortoInova.Models.Carrinho
@using TesteHortoInova.Models

@{
    ViewData["Title"] = "Home Page";
    Layout = null; // Defina o layout principal, se necessário
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HortoInova - Carrinho de Compras</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link href="~/css/styles.css" rel="stylesheet" />
</head>
<body>

     <!-- Login -->
    <div id="loginModal" class="modal">
        <div class="modal-overlay"></div>
        <div class="modal-content">
            <h2>Login</h2>
            <form method="post" action="/Login/Entrar">
                <input type="email" name="email" class="input-field" placeholder="Digite seu e-mail" required>
                <input type="password" name="senha" class="input-field" placeholder="Digite sua senha" required>
                <button type="submit" class="btn-login">Entrar</button>
                <a href="/Login/Registrar" class="btn-register">Cadastrar</a>
            </form>
            
        </div>
    </div>

    <script>
        // Exibe o modal de login ao carregar a página
        document.addEventListener("DOMContentLoaded", function() {
        const loginModal = document.getElementById("loginModal");
        loginModal.style.display = "flex";
    });
    </script>

    <!-- Header -->
    <section class="topo">
        <div class="home">
            <h2 class="bem-vindo">Bem Vindo!</h2>
            <h1 class="HortoInova">HortoInova</h1>
        </div>
    </section>
    

    <!-- Carrinho Container -->
    <div class="container">
        <h2>Carrinho de Compras</h2>

        <table>
            <tr>
                <th>Produto</th>
                <th>Preço de Custo</th>
                <th>Quantidade</th>
                <th>Total</th>
                <th>Ações</th>
            </tr>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td>@item.Produto.NomeProduto</td>
                    <td>@item.Produto.Preco.ToString("C")</td>
                    <td>@item.Quantidade</td>
                    <td>@item.Total.ToString("C")</td>
                    <td class="actions">
                        <a href="@Url.Action("Remover", "Carrinho", new { id = item.Produto.IdProduto })">Remover</a>
                    </td>
                </tr>
            }
        </table>

        <h3 class="total">Total do Carrinho: @Model.TotalCarrinho.ToString("C")</h3>

        <a href="@Url.Action("Limpar", "Carrinho")" class="clear-cart">Limpar Carrinho</a>
        <!-- Botão para criar pedido -->
        <a href="@Url.Action("CriarPedido", "Carrinho")" class="buy-button">Comprar</a>


        <h4>Produtos Disponíveis</h4>
        <div class="available-products">
            @foreach (var produto in CarrinhoController._produtos)
            {
                <p>
                    <strong>@produto.NomeProduto</strong><br>
                    Preço de Custo: @produto.Preco.ToString("C")<br>
                    
                    <a href="@Url.Action("Adicionar", "Carrinho", new { id = produto.IdProduto })">Adicionar ao Carrinho</a>
                </p>
            }
        </div>
        <!-- About Section -->
    </div>
    <section>
        <div class="about-farm">
            <h4>Sobre a Fazenda</h4>
            <p>
                A fazenda urbana HortoInova é dedicada a fornecer produtos orgânicos e saudáveis, cultivados com práticas sustentáveis.
                Nossos produtos são frescos, saudáveis e livres de agrotóxicos, garantindo qualidade e saúde para a sua mesa.
            </p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2024 HortoInova. Todos os direitos reservados.</p>
        <p>Orgulhosamente fornecendo produtos frescos e saudáveis.</p>
    </footer>

</body>
</html>
