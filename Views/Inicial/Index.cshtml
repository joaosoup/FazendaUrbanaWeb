@model TesteHortoInova.Models.salvar_dados
@using TesteHortoInova.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>


<style>
    * {
        padding: 0;
        margin: 0;
    }

    body {
        background-color: #eaf4ea;
        font-family: Arial, sans-serif;
    }

    .container {
        max-width: 400px;
        margin: 50px auto;
        background-color: #ffffff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
    }

    h2 {
        text-align: center;
        color: #4CAF50; 
        font-weight: bold;
        margin-bottom: 20px;
    }

    input[type="email"],
    input[type="password"] {
        width: 100%;
        height: 50px;
        border-radius: 10px;
        border: 1px solid #cccccc;
        padding: 10px;
        font-size: 1.1em;
        margin-bottom: 15px; 
    }

        input[type="email"]:focus,
        input[type="password"]:focus {
            border-color: #4CAF50; 
            box-shadow: 0 0 5px rgba(76, 175, 80, 0.25);
            outline: none;
        }

    .btn-primary {
        width: 100%;
        background-color: #4CAF50; 
        border-color: #4CAF50;
        border-radius: 8px;
        height: 50px;
        font-size: 1.2em;
        font-weight: bold;
        color: #ffffff;
        margin-top: 15px;
    }

        .btn-primary:hover {
            background-color: #45a049;
        }

    .alert-info {
        width: 100%;
        background-color: #ffc107;
        color: #ffffff;
        border-radius: 8px;
        padding: 10px;
        margin-top: 15px; 
        font-size: 1em;
        text-align: center;
    }

    .topo {
        display: flex;
        flex-direction: column;
        height: 30vh;
        background-color: #4CAF50;
        width: 100%;
        align-items: center;
        justify-content: center;
        padding: 0;
        margin: 0;
    }

    .bem-vindo {
        font-size: 34px;
        color: #fff;
        margin: 0;
        line-height: 1;
    }

    .HortoInova {
        font-size: 80px;
        color: #fff;
        margin: 0;
        line-height: 1;
    }

    .btn-second{
        width: 100%;
        background-color: #235225;
        border-color: #235225;
        border-radius: 8px;
        height: 50px;
        font-size: 1.2em;
        font-weight: bold;
        color: #ffffff;
        margin-top: 15px;
        
    }

        .btn-second:hover {
        background-color: #45a049;
    }

    .modal-dialog {
        max-width: 400px;
        margin: 1.75rem auto;
    }

    .modal-content {
        padding: 20px;
    }


</style>

<section class="topo">
    <div class="home">
        <h2 class="bem-vindo">Bem Vindo!</h2>
        <h1 class="HortoInova">HortoInova</h1>
    </div>
</section>

<div class="container">
    <h2>Login</h2>
    <form method="post" asp-action="Entrar" asp-controller="Inicial">
        <input type="email" name="email" placeholder="Digite seu Email" required />
        <input type="password" name="senha" placeholder="Digite sua Senha" required />
        <button type="submit" class="btn-primary">Entrar</button>
        <button type="button" class="btn-second" data-bs-toggle="modal" data-bs-target="#registerModal">Registrar-se</button>
    </form>
</div>

<div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="registerModalLabel">Criar Conta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-action="Registrar" asp-controller="Inicial">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" required />
                    </div>
                    <div class="mb-3">
                        <label for="senha" class="form-label">Senha</label>
                        <input type="password" class="form-control" id="senha" name="senha" required />
                    </div>
                    <button type="submit" class="btn-primary">Registrar</button>
                </form>
            </div>
        </div>
    </div>
</div>
}



