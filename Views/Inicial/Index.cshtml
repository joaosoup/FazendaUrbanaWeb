@model TesteHortoInova.Models.salvar_dados
@using TesteHortoInova.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Login";
}

<style>
    * {
        padding: 0;
        margin: 0;
    }

    body {
        background-color: #eaf4ea;
        font-family: Arial, sans-serif;
    }

    .container {
        max-width: 400px;
        margin: 50px auto;
        background-color: #ffffff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
    }

    h2 {
        text-align: center;
        color: #4CAF50; /* Verde escuro */
        font-weight: bold;
        margin-bottom: 20px;
    }

    input[type="email"],
    input[type="password"] {
        width: 100%;
        height: 50px;
        border-radius: 10px;
        border: 1px solid #cccccc;
        padding: 10px;
        font-size: 1.1em;
        margin-bottom: 15px; /* Espaçamento entre os inputs */
    }

        input[type="email"]:focus,
        input[type="password"]:focus {
            border-color: #4CAF50; /* Verde escuro */
            box-shadow: 0 0 5px rgba(76, 175, 80, 0.25);
            outline: none;
        }

    .btn-primary {
        width: 100%;
        background-color: #4CAF50; /* Verde escuro */
        border-color: #4CAF50;
        border-radius: 8px;
        height: 50px;
        font-size: 1.2em;
        font-weight: bold;
        color: #ffffff;
        margin-top: 15px;
    }

        .btn-primary:hover {
            background-color: #45a049; /* Verde mais escuro */
        }

    .alert-info {
        width: 100%;
        background-color: #ffc107; /* Amarelo */
        color: #ffffff;
        border-radius: 8px;
        padding: 10px;
        margin-top: 15px; /* Espaçamento entre o alerta e o botão */
        font-size: 1em;
        text-align: center;
    }

    .topo {
        display: flex;
        flex-direction: column;
        height: 30vh;
        background-color: #4CAF50;
        width: 100%;
        align-items: center;
        justify-content: center;
        padding: 0;
        margin: 0;
    }

    .bem-vindo {
        font-size: 34px;
        color: #fff;
        margin: 0;
        line-height: 1;
    }

    .HortoInova {
        font-size: 80px;
        color: #fff;
        margin: 0;
        line-height: 1;
    }
</style>

<section class="topo">
    <div class="home">
        <h2 class="bem-vindo">Bem Vindo!</h2>
        <h1 class="HortoInova">HortoInova</h1>
    </div>
</section>

<div class="container">
    <h2>Login</h2>
    <form method="post" asp-action="Entrar" asp-controller="Inicial">
        <input type="email" name="email" placeholder="Digite seu Email" required />
        <input type="password" name="senha" placeholder="Digite sua Senha" required />
        <button type="submit" class="btn-primary">Entrar</button>
    </form>
    @if (ViewBag.AlertMessage != null)
    {
        <div class="alert alert-info">
            @ViewBag.AlertMessage
        </div>
    }

</div>


